# ---- VendoPOS backend environment ----

# NeonDB connection string. Get this from the Neon dashboard:
#   https://console.neon.tech  ->  your project  ->  Connection Details  ->  "Connection string"
# It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_yG1M6bjRZqNf@ep-broad-firefly-aodttuwe-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Port the Express API listens on.
PORT=4000

# Comma-separated list of allowed browser origins (the Next.js frontend).
# In dev the frontend runs on http://localhost:3000.
CORS_ORIGIN=http://localhost:3000

# ---- Authentication (direct Google OAuth, handled on the backend) ----
# The backend itself constructs the Google consent URL, exchanges the auth code,
# looks the email up in the `users` table, and signs the application JWT. The
# client secret never reaches the browser. Leave these blank to run the API
# without sign-in (the rest of the app still boots); /auth/google then redirects
# to /login?error=auth_unconfigured.

# Where the browser lives — the backend redirects here after login.
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 client (https://console.cloud.google.com → APIs & Services →
# Credentials → "OAuth client ID" → Web application). Add the redirect URI below
# to the client's "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Secret for signing the application JWT. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Session cookie. Set COOKIE_DOMAIN (e.g. .vendopos.com) only when the frontend
# and API are on split subdomains; leave blank for localhost.
SESSION_COOKIE_NAME=vendopos_session
COOKIE_DOMAIN=

# ---- Media storage ----
# Public origin used to build product-image URLs. The default storage provider
# writes uploads to ./uploads and serves them at /uploads; this is the host part
# of the returned image_url. Point a CDN/bucket origin here in production.
PUBLIC_BASE_URL=http://localhost:4000

# ---- Transactional email (Lead onboarding) ----
# When the Super Admin provisions a Lead into a store, the new owner is emailed
# their onboarding steps + sign-in details. This is OPTIONAL: leave RESEND_API_KEY
# blank and the message is logged to the server console instead of sent, so the
# flow works with zero setup. Set the key to deliver for real.
#
# RESEND_API_KEY — from https://resend.com → API Keys (starts with "re_").
# EMAIL_FROM     — the sender; must be a verified sender on your Resend domain.
RESEND_API_KEY=
EMAIL_FROM=VendoPOS <onboarding@resend.dev>

# Where internal ops alerts go (currently the Enterprise concierge inquiry). The
# same transport as above: with RESEND_API_KEY blank it's logged, not sent. Leave
# blank to fall back to EMAIL_FROM as the recipient.
ADMIN_ALERT_EMAIL=